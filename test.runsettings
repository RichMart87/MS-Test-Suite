<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Backstop for the whole test run; a hung test (stale WebDriver wait, dead
       network call) should never be able to block CI indefinitely. Individual
       test timeouts are enforced via [Timeout] on each test method. -->
  <RunConfiguration>
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
